Function chk(name$, got$, want$)
	If got = want Then
		RT_Trace("ok   " + name)
	Else
		RT_Trace("FAIL " + name + " got=[" + got + "] want=[" + want + "]")
	EndIf
End Function
a$ = "Hello, World"
chk("left3", Left(a, 3), "Hel")
chk("left0", Left(a, 0), "")
chk("left99", Left(a, 99), a)
chk("right5", Right(a, 5), "World")
chk("right0", Right(a, 0), "")
chk("right99", Right(a, 99), a)
chk("right1", Right(a, 1), "d")
chk("mid", Mid(a, 8, 5), "World")
chk("mid2", Mid(a, 8), "World")
chk("mid3", Mid(a, 1, 0), "")
chk("mid4", Mid(a, 50, 3), "")
chk("mid5", Mid(a, 11, 99), "ld")
chk("instr1", Str(Instr(a, "o")), "5")
chk("instr2", Str(Instr(a, "o", 6)), "9")
chk("instr3", Str(Instr(a, "zz")), "0")
chk("instr4", Str(Instr(a, "")), "1")
chk("upper", Upper(a), "HELLO, WORLD")
chk("lower", Lower(a), "hello, world")
chk("trim", Trim("  ab  "), "ab")
chk("len", Str(Len(a)), "12")
chk("replace", Replace(a, "l", "L"), "HeLLo, WorLd")
chk("replace2", Replace(a, "ll", ""), "Heo, World")
chk("chr", Chr(65), "A")
chk("asc", Str(Asc("A")), "65")
chk("str1", Str(1.5), "1.5")
chk("str2", Str(10), "10")
chk("str3", Str(0.1), "0.1")
chk("str4", Str(100.0), "100.0")
chk("str5", Str(-2.25), "-2.25")
chk("str6", Str(1.0/3.0), "0.333333")
chk("int1", Str(Int("  12abc")), "12")
chk("int2", Str(Int("-5")), "-5")
chk("float1", Str(Float("1.5abc")), "1.5")
chk("float2", Str(Float("abc")), "0.0")
chk("hex", Hex(255), "000000FF")
chk("bin", Bin(5), "00000000000000000000000000000101")
chk("string", String("ab", 3), "ababab")
chk("lset", LSet("ab", 5) + "|", "ab   |")
chk("rset", RSet("ab", 5), "   ab")
chk("cmp1", Str("a" < "b"), "1")
chk("cmp2", Str("abc" = "abc"), "1")
chk("cmp3", Str("B" > "a"), "0")
chk("sh1", Str(1 Shl 4), "16")
chk("sh2", Str(-16 Shr 2), "1073741820")
chk("sh3", Str(-16 Sar 2), "-4")
chk("mod1", Str(-7 Mod 3), "-1")
chk("mod2", Str(7.5 Mod 2), "1.5")
chk("div1", Str(7 / 2), "3")
chk("div2", Str(7 / 2.0), "3.5")
chk("pow", Str(2 ^ 10), "1024.0")
chk("sqr", Str(Sqr(16)), "4.0")
chk("floor", Str(Floor(-1.5)), "-2.0")
chk("ceil", Str(Ceil(1.2)), "2.0")
chk("abs", Str(Abs(-3)), "3")
chk("sgn", Str(Sgn(-3.2)), "-1.0")
chk("sin", Str(Sin(90)), "1.0")
chk("cos", Str(Cos(0)), "1.0")
chk("atan2", Str(ATan2(1, 1)), "45.0")
n5% = 5 : nn% = Not n5 : chk("not", Str(nn), "0")
chk("and", Str(6 And 3), "2")
chk("or", Str(6 Or 3), "7")
chk("xor", Str(6 Xor 3), "5")
chk("intmax", Str(2147483647 + 1), "-2147483648")
chk("mul", Str(100000 * 100000), "1410065408")
chk("fl2int", Str(Int(10000000000.0)), "-2147483648")
chk("neg", Str(-(5)), "-5")
RT_Trace("done")
End
